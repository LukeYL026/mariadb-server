
--source include/have_geometry.inc

--echo #
--echo # MDEV-29952 Spatial References needs better documenting
--echo #
--echo # REF_SYSTEM_ID is a column attribute for spatial data types that sets
--echo # the Spatial Reference System ID (SRID) for geometry columns.
--echo # Added in MariaDB 10.1.2.
--echo #
--echo # Syntax: col_name spatial_type REF_SYSTEM_ID = <integer>
--echo #

--echo #
--echo # 1. Basic usage: SRID is stored and visible in information_schema.geometry_columns
--echo #

CREATE TABLE t1 (g GEOMETRY(9,4) REF_SYSTEM_ID=101, pt POINT(8,2), pg GEOMETRY REF_SYSTEM_ID=102);
SELECT SRID FROM information_schema.geometry_columns
  WHERE f_table_schema='test' AND g_table_name='t1';
DROP TABLE t1;

--echo #
--echo # 2. Columns without REF_SYSTEM_ID default to SRID=0
--echo #

CREATE TABLE t1 (g GEOMETRY, pt POINT);
SELECT F_GEOMETRY_COLUMN, SRID
  FROM information_schema.geometry_columns
  WHERE f_table_schema='test' AND f_table_name='t1'
  ORDER BY F_GEOMETRY_COLUMN;
DROP TABLE t1;

--echo #
--echo # 3. REF_SYSTEM_ID=0 is equivalent to omitting REF_SYSTEM_ID (both yield SRID=0)
--echo #

CREATE TABLE t1 (a GEOMETRY REF_SYSTEM_ID=0, b GEOMETRY);
SELECT F_GEOMETRY_COLUMN, SRID
  FROM information_schema.geometry_columns
  WHERE f_table_schema='test' AND f_table_name='t1'
  ORDER BY F_GEOMETRY_COLUMN;
DROP TABLE t1;

--echo #
--echo # 4. REF_SYSTEM_ID is not allowed on non-spatial data types
--echo #

--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE TABLE t1 (a INT REF_SYSTEM_ID=101);

--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE TABLE t1 (a VARCHAR(10) REF_SYSTEM_ID=101);

--echo #
--echo # 5. UNION of spatial columns with different non-zero SRIDs is rejected
--echo #

CREATE TABLE t1 (a POINT REF_SYSTEM_ID=101, b POINT REF_SYSTEM_ID=102);
--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
SELECT a FROM t1 UNION SELECT b FROM t1;
DROP TABLE t1;

--echo #
--echo # 6. UNION with SRID=0 (unspecified) and a non-zero SRID is also rejected
--echo #

CREATE TABLE t1 (a POINT REF_SYSTEM_ID=0, b POINT REF_SYSTEM_ID=102);
--error ER_ILLEGAL_PARAMETER_DATA_TYPES2_FOR_OPERATION
SELECT a FROM t1 UNION SELECT b FROM t1;
DROP TABLE t1;

--echo #
--echo # 7. UNION of columns with the same non-zero SRID is allowed
--echo #

CREATE TABLE t1 (a POINT REF_SYSTEM_ID=101, b POINT REF_SYSTEM_ID=101);
CREATE TABLE t2 AS SELECT a FROM t1 UNION SELECT b FROM t1;
DROP TABLE t1, t2;

--echo #
--echo # 8. REF_SYSTEM_ID is preserved when adding columns via ALTER TABLE
--echo #

CREATE TABLE t1 (g GEOMETRY REF_SYSTEM_ID=101);
SELECT F_GEOMETRY_COLUMN, SRID
  FROM information_schema.geometry_columns
  WHERE f_table_schema='test' AND f_table_name='t1';

ALTER TABLE t1 ADD COLUMN h POINT REF_SYSTEM_ID=202;
SELECT F_GEOMETRY_COLUMN, SRID
  FROM information_schema.geometry_columns
  WHERE f_table_schema='test' AND f_table_name='t1'
  ORDER BY F_GEOMETRY_COLUMN;
DROP TABLE t1;

--echo #
--echo # End of MDEV-29952 tests
--echo #